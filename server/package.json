{
  "name": "uebersicht-server",
  "version": "0.0.0",
  "description": "Node.js backend for Übersicht",
  "main": "server.js",
  "scripts": {
    "test": "npm run-script test-local && npm run-script test-browser",
    "test-local": "tape spec/backend/**/* | tap-spec",
    "test-browser": "browserify -t coffeeify  spec/frontend/*.*  | tape-run | tap-spec",
    "start": "node server.js",
    "release": "npm run-script build-client && npm run-script build-server",
    "build-client": "node scripts/build-client.js",
    "build-server": "node scripts/build-server.js && cd release && npm prune --production && npm install --production --no-progress"
  },
  "author": "Felix Hageloh",
  "license": "GPL v3 <http://www.gnu.org/licenses/>",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sinon": "^4.0.1",
    "tap-spec": "^5.0.0",
    "tape": "^4.13.3",
    "tape-run": "^9.0.0"
  },
  "dependencies": {
    "@emotion/core": "^10.0.35",
    "@emotion/styled": "^10.0.27",
    "browserify": "^16.5.2",
    "byline": "^5.0.0",
    "coffee-script": "^1.12.7",
    "coffeeify": "^2.1.0",
    "connect": "^3.6.5",
    "convert-source-map": "^1.7.0",
    "cors-anywhere": "^0.4.3",
    "emotion": "^10.0.27",
    "escodegen": "^1.14.3",
    "esprima": "^2.7.3",
    "fsevents": "^2.3",
    "jquery": "^3.5.1",
    "minimist": "^1.2.5",
    "ms": "^2.0.0",
    "nib": "~1.1.2",
    "raf": "^3.4.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "redux": "^3.7.2",
    "serve-static": "^1.13.1",
    "source-map": "^0.7.3",
    "stylus": "^0.54.8",
    "superagent": "^3.8.3",
    "through2": "^2.0.3",
    "tmp": "0.0.33",
    "tosource": "~1.0.0",
    "ws": "^6.0.0"
  }
}
